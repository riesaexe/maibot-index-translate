{
  "manifest_version": 2,
  "id": "riesa.translate",
  "version": "1.7.0",
  "name": "中文翻译",
  "description": "使用 Index-Translate 将聊天文字和图片翻译为中文，支持自定义触发命令（默认 /rs 翻译）与引用消息",
  "author": {"name": "RiESA", "url": "https://github.com/riesaexe"},
  "urls": {
    "repository": "https://github.com/riesaexe/maibot-index-translate",
    "homepage": "https://github.com/riesaexe/maibot-index-translate",
    "documentation": "https://github.com/riesaexe/maibot-index-translate/blob/main/README.md",
    "issues": "https://github.com/riesaexe/maibot-index-translate/issues"
  },
  "display": {"icon": {"type": "local", "value": "icon.png", "fallback": "languages"}},
  "license": "MIT",
  "host_application": {"min_version": "1.3.10", "max_version": "1.3.99"},
  "sdk": {"min_version": "2.12.0", "max_version": "2.12.99"},
  "dependencies": [
    {"type": "python_package", "name": "httpx", "version_spec": ">=0.28.1"},
    {"type": "python_package", "name": "pydantic", "version_spec": ">=2.0"},
    {"type": "python_package", "name": "anyio", "version_spec": ">=4.0"},
    {"type": "python_package", "name": "pillow", "version_spec": ">=10.0"},
    {"type": "python_package", "name": "rapidocr-onnxruntime", "version_spec": ">=1.4.4,<2"},
    {"type": "python_package", "name": "onnxruntime", "version_spec": ">=1.20"},
    {"type": "python_package", "name": "manga-ocr", "version_spec": ">=0.1.16,<0.2"},
    {"type": "python_package", "name": "numpy", "version_spec": ">=1.26"},
    {"type": "python_package", "name": "opencv-python", "version_spec": ">=4.5"}
  ],
  "plugin_type": "tool",
  "capabilities": ["send.text", "send.hybrid", "message.get_by_id"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
